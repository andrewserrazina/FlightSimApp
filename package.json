{
  "name": "flightsimapp",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build && pnpm --filter @flightsim/desktop build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "bridge:build": "dotnet build services/sim-bridge/FlightSim.SimBridge.sln -c Release",
    "bridge:test": "dotnet test services/sim-bridge/FlightSim.SimBridge.sln",
    "bridge:mock": "dotnet run --project services/sim-bridge/src/FlightSim.SimBridge.Host -- --adapter mock --dev-token-from-env",
    "desktop:dev": "pnpm --filter @flightsim/desktop tauri dev"
  }
}
