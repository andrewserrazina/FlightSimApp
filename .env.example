# FlightSimApp environment template.
# Copy to `.env` for local development. `.env` is git-ignored — never commit real values.
#
# Only PUBLIC values may ever be exposed to the desktop webview. Variables prefixed
# VITE_ are bundled into browser-visible code by Vite, so NEVER put a secret behind VITE_.

# --- Sim bridge (desktop shell -> local sidecar) ---
# Adapter to start: mock | msfs2020 | msfs2024
FLIGHTSIM_BRIDGE_ADAPTER=mock
# Optional absolute path to a prebuilt bridge executable. When unset in dev, the
# desktop shell runs `dotnet run --project services/sim-bridge/src/FlightSim.SimBridge.Host`.
FLIGHTSIM_BRIDGE_PATH=
# The per-session bridge token is generated at runtime by the desktop shell and passed
# to the bridge over stdin. There is intentionally NO token variable here.

# --- Cloud (S1-05, optional; the app works fully offline without these) ---
# Public project URL and PUBLIC anon key only (RLS protects every table). Leave empty for a
# local-only build. https is required, except http://127.0.0.1 / localhost for local dev.
# Local stack (infra/supabase-local): URL http://127.0.0.1:54321, key from
#   node infra/supabase-local/keys.mjs   (copy SUPABASE_ANON_KEY; never the service-role key)
# A local-stack desktop build also needs the CSP overlay:
#   pnpm --filter @flightsim/desktop tauri build --config src-tauri/tauri.local-supabase.conf.json
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side only. Never set in the desktop environment, never prefix with VITE_.
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
