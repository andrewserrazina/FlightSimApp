{
  "name": "@flightsim/flight-core",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic, typed flight lifecycle utilities shared by pilot and future airline-management products.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "pnpm typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vitest": "3.1.2",
    "@types/node": "22.15.3"
  }
}
