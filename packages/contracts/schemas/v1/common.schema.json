{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.flightsimapp.invalid/v1/common.schema.json",
  "title": "FlightSimApp common definitions v1",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "utc_timestamp": {
      "description": "RFC 3339 timestamp in UTC. Must end in 'Z'; offsets are rejected so ordering never depends on local time.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "simulator_id": {
      "description": "Which simulator produced the data. 'mock' is demo data and must be labelled as such in any UI.",
      "enum": ["mock", "msfs2020", "msfs2024"]
    },
    "connection_state_name": {
      "enum": ["DISCONNECTED", "CONNECTING", "CONNECTED", "STALE", "RECONNECTING", "ERROR"]
    },
    "session_seq": {
      "description": "Monotonically increasing per bridge session, starting at 1.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64 },
        "message": { "type": "string", "maxLength": 512 }
      }
    }
  }
}
