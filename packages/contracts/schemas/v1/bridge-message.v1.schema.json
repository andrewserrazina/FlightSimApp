{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.flightsimapp.invalid/v1/bridge-message.v1.schema.json",
  "title": "BridgeMessageV1",
  "description": "One newline-delimited JSON message on the local bridge pipe. The first client message must be 'hello'; anything else closes the connection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "protocol_version", "type", "data"],
  "properties": {
    "protocol": { "const": "flightsim.bridge" },
    "protocol_version": { "const": 1 },
    "type": {
      "enum": ["hello", "hello.ok", "connection.state", "telemetry.frame", "flight.event", "bridge.health", "gsx.state", "health.request", "adapter.reconnect", "error"]
    },
    "data": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "hello" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/hello" } } } },
    { "if": { "properties": { "type": { "const": "hello.ok" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/hello_ok" } } } },
    { "if": { "properties": { "type": { "const": "connection.state" } } }, "then": { "properties": { "data": { "$ref": "connection-state.v1.schema.json" } } } },
    { "if": { "properties": { "type": { "const": "telemetry.frame" } } }, "then": { "properties": { "data": { "$ref": "telemetry-frame.v1.schema.json" } } } },
    { "if": { "properties": { "type": { "const": "flight.event" } } }, "then": { "properties": { "data": { "$ref": "flight-event.v1.schema.json" } } } },
    { "if": { "properties": { "type": { "const": "bridge.health" } } }, "then": { "properties": { "data": { "$ref": "bridge-health.v1.schema.json" } } } },
    { "if": { "properties": { "type": { "const": "gsx.state" } } }, "then": { "properties": { "data": { "$ref": "gsx-state.v1.schema.json" } } } },
    { "if": { "properties": { "type": { "enum": ["health.request", "adapter.reconnect"] } } }, "then": { "properties": { "data": { "type": "object", "maxProperties": 0 } } } },
    { "if": { "properties": { "type": { "const": "error" } } }, "then": { "properties": { "data": { "$ref": "common.schema.json#/$defs/reason" } } } }
  ],
  "$defs": {
    "hello": {
      "description": "Client authentication. The token is per bridge process, generated by the desktop shell and never exposed to the webview or logs.",
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "client"],
      "properties": {
        "token": { "type": "string", "minLength": 43, "maxLength": 128 },
        "client": { "type": "string", "maxLength": 64 }
      }
    },
    "hello_ok": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bridge_version", "session_id", "adapter"],
      "properties": {
        "bridge_version": { "type": "string", "maxLength": 64 },
        "session_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "adapter": { "$ref": "common.schema.json#/$defs/simulator_id" }
      }
    }
  }
}
