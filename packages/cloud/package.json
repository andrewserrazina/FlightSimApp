{
  "name": "@flightsim/cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud sync contract (payload mapping, error classification, entitlement types) and Supabase security integration tests.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "pnpm typecheck",
    "test": "vitest run --exclude test/**/*.integration.test.ts",
    "test:integration": "vitest run test/rls.integration.test.ts test/auth.integration.test.ts --no-file-parallelism"
  },
  "dependencies": {
    "@flightsim/flight-core": "workspace:*",
    "@supabase/supabase-js": "2.117.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/pg": "8.11.10",
    "pg": "8.13.1",
    "typescript": "5.8.3",
    "vitest": "3.1.2"
  }
}
